---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { CONTACT, PROFILE, SOCIAL_LINKS } from '../data/portfolio';
---

<BaseLayout title={`Contact | ${PROFILE.name}`}>
  <h1 class="mt-10 text-3xl font-bold text-center">CONTACT</h1>

  <div class="container px-4 mx-auto mt-10">
    <div class="flex flex-col items-center justify-center gap-10 pb-10 md:flex-row">
      

      <div class="text-center md:text-left">
        <h2 class="mb-4 text-2xl font-bold md:text-4xl">{PROFILE.displayName}</h2>
        <div class="space-y-3 text-base text-gray-700 md:text-lg">
          <p class="font-semibold">{PROFILE.degree}</p>
          <p>{PROFILE.faculty}</p>

          <div class="pt-4 space-y-1">
            <p>
              <span class="font-bold">Tel:</span>{' '}
              <a href={CONTACT.telHref} class="hover:underline">{CONTACT.telDisplay}</a>
            </p>
            <p>
              <span class="font-bold">Email:</span>{' '}
              <a href={`mailto:${CONTACT.email}`} class="hover:underline">{CONTACT.email}</a>
            </p>
            <p>
              <span class="font-bold">Line ID:</span> {CONTACT.lineId}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <SocialLinks links={SOCIAL_LINKS} />
</BaseLayout>
