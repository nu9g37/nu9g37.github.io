---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Personal portfolio of Setthawut Jitsom, Computer Engineering and Digital Technology student at Chulalongkorn University.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="font-sans">
    <Navbar />
    <main>
      <slot />
    </main>
  </body>
</html>
