---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { PORTFOLIO_ITEMS, PROFILE } from '../data/portfolio';
---

<BaseLayout title={PROFILE.name}>
  <h1 class="mt-10 text-3xl font-bold text-center">MY PORTFOLIO</h1>

  <div>
    
    <p class="mt-10 text-2xl text-center">{PROFILE.name}</p>
  </div>

  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="m-10 text-3xl font-bold text-center">
      PROJECTS &amp; CERTIFICATES
    </h2>

    {PORTFOLIO_ITEMS.map((item) => <ProjectCard item={item} />)}
  </section>
</BaseLayout>
