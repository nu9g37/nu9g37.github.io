---
import type { SocialLink } from '../data/portfolio';

interface Props {
  links: SocialLink[];
}

const { links } = Astro.props;

interface PlatformMeta {
  d: string;
  fillRule?: 'evenodd';
  subtitle: string;
  cardHoverClass: string;
  badgeClass: string;
  accentBarClass: string;
}

const PLATFORM_META: Record<SocialLink['platform'], PlatformMeta> = {
  facebook: {
    d: 'M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12Z',
    subtitle: 'Social profile',
    cardHoverClass: 'hover:border-[#1877F2]/40 hover:shadow-[#1877F2]/10',
    badgeClass:
      'bg-blue-50/90 text-[#1877F2] ring-blue-200/70 group-hover:bg-[#1877F2] group-hover:text-white group-hover:ring-[#1877F2]',
    accentBarClass: 'bg-linear-to-r from-[#1877F2] via-sky-400 to-[#1877F2]',
  },
  github: {
    d: 'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z',
    fillRule: 'evenodd',
    subtitle: 'Code & projects',
    cardHoverClass: 'hover:border-slate-400/70 hover:shadow-slate-900/10',
    badgeClass:
      'bg-slate-100 text-slate-800 ring-slate-200/80 group-hover:bg-slate-900 group-hover:text-white group-hover:ring-slate-900',
    accentBarClass: 'bg-linear-to-r from-slate-700 via-slate-950 to-slate-700',
  },
  linkedin: {
    d: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z',
    subtitle: 'Career & network',
    cardHoverClass: 'hover:border-[#0A66C2]/40 hover:shadow-[#0A66C2]/10',
    badgeClass:
      'bg-sky-50/90 text-[#0A66C2] ring-sky-200/70 group-hover:bg-[#0A66C2] group-hover:text-white group-hover:ring-[#0A66C2]',
    accentBarClass: 'bg-linear-to-r from-[#0A66C2] via-sky-500 to-[#0A66C2]',
  },
};
---

{links.length > 0 && (
  <section aria-labelledby="social-links-heading" class="w-full max-w-2xl px-4 mx-auto mb-14">
    <div class="flex flex-col gap-3.5 sm:flex-row sm:flex-wrap sm:justify-center">
      {links.map((link) => {
        const meta = PLATFORM_META[link.platform];
        return (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'group relative flex w-full items-center gap-3.5 overflow-hidden rounded-2xl border border-slate-200/90 bg-white px-4 py-3.5 text-slate-900 shadow-sm shadow-slate-200/70 transition-all duration-300 hover:shadow-lg motion-safe:hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 sm:min-w-[190px] sm:flex-1 sm:max-w-[220px]',
              meta.cardHoverClass,
              link.hoverClass,
            ]}
          >
            <span
              aria-hidden="true"
              class:list={[
                'absolute inset-x-0 top-0 h-0.5 opacity-0 transition-opacity duration-300 group-hover:opacity-100',
                meta.accentBarClass,
              ]}
            />

            <span
              aria-hidden="true"
              class:list={[
                'flex h-10 w-10 shrink-0 items-center justify-center rounded-xl ring-1 transition-all duration-300 motion-safe:group-hover:scale-105',
                meta.badgeClass,
              ]}
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d={meta.d}
                  fill-rule={meta.fillRule}
                  clip-rule={meta.fillRule}
                />
              </svg>
            </span>

            <span class="flex-1 min-w-0 text-left">
              <span class="block text-sm font-semibold truncate transition-colors duration-200">
                {link.label}
              </span>
              <span class="block text-xs font-normal truncate text-slate-500">
                {meta.subtitle}
              </span>
            </span>

            <svg
              class="h-4 w-4 shrink-0 text-slate-400 transition-all duration-200 group-hover:text-inherit motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7" />
              <path d="M7 7h10v10" />
            </svg>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        );
      })}
    </div>
  </section>
)}
